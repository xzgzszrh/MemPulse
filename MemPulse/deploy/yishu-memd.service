[Unit]
Description=MemPulse topic memory daemon (yishu-memd)
After=default.target

[Service]
Type=simple
Environment=MEMPULSE_SOCKET=%t/mempulse.sock
Environment=MEMPULSE_DB=%h/.local/share/mempulse/memory.sqlite3
ExecStart=%h/MemPulse/.venv/bin/yishu daemon --socket %t/mempulse.sock
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
